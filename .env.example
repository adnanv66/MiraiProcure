# Environment Variables Template for MiraiProcure (未来プロキュア)

# Production PostgreSQL Database URL (e.g. Supabase, Neon, Vercel Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/miraiprocure?schema=public"

# Auth.js / NextAuth Secret
NEXTAUTH_SECRET="miraiprocure_production_jwt_secret_key_demo_2026"
NEXTAUTH_URL="http://localhost:3000"

# Gemini AI API Key (Optional - application runs in Demo AI Fallback Mode if empty)
GEMINI_API_KEY=""

# Object Storage Token (Vercel Blob / S3 abstraction)
BLOB_READ_WRITE_TOKEN=""

# Public Application Metadata
NEXT_PUBLIC_APP_NAME="MiraiProcure"
NEXT_PUBLIC_APP_JAPANESE="MiraiProcure AI OS"
NEXT_PUBLIC_APP_TAGLINE="From Intent to Invoice — AI-powered procurement with humans in control."
